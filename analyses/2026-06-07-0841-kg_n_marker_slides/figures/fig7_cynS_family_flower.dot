// cynS gene-family "flower": ortholog group centre, genomes as petals,
// experiments at the rim. Edge colour = expression change; gold outline = N experiment.
// cynS has DE data in only 3 of 10 genomes — the "cleanest marker, least measured" point.
// Render: twopi -Tpng fig7_cynS_family_flower.dot -o fig7_cynS_family_flower.png
digraph cynS_flower {
  layout=twopi;
  root=FAM;
  ranksep="1.3 0.7";
  overlap=false;
  splines=curved;
  sep="+10";
  nodesep=0.4;
  bgcolor="white";
  labelloc="b";
  fontname="Helvetica";
  fontsize=13;
  label="Edge colour = expression change:  red = up   blue = down   grey = not significant\lGold outline = nitrogen-stress experiment\l";
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12,
        color="#1b2631", penwidth=1.2, margin="0.12,0.07"];
  edge [penwidth=3.0, arrowsize=0.6];

  // centre = ortholog group
  FAM [label="Cyanate hydratase\n(cynS)\n— one gene family —\nDE data in only\n3 of 10 genomes\n8 publications",
       shape=ellipse, fillcolor="#1b3a4b", fontcolor="white", fontsize=15, penwidth=2.5,
       width=2.3, height=2.3, fixedsize=true];

  // ring 1 = genes (only the genomes that actually have cynS expression data)
  node [fillcolor="#2c3e50", fontcolor="white"];
  MED4 [label="Prochlorococcus\nMED4"];
  NAT  [label="Prochlorococcus\nNATL2A"];
  WH7  [label="Synechococcus\nWH7803"];

  // ring 2 = experiments
  node [fillcolor="#f4f6f7", fontcolor="#2c3e50", fontsize=11];
  c1 [label="N depletion\nRead 2017",        fillcolor="#fff3c4", color="#e0a800", penwidth=3.5];
  c2 [label="N starvation\nWeissberg 2025",  fillcolor="#fff3c4", color="#e0a800", penwidth=3.5];
  c3 [label="N source switch\nTolonen 2006", fillcolor="#fff3c4", color="#e0a800", penwidth=3.5];
  c4 [label="low CO₂\nBagby 2015"];
  c5 [label="coculture\nWeissberg 2025"];
  c6 [label="extended darkness\nBiller 2018"];
  c7 [label="dark co-culture\nCoe 2024"];
  c8 [label="co-culture\nChristie-Oleza 2017"];

  // membership edges (neutral)
  edge [color="#34495e", penwidth=2.2, arrowhead=none];
  FAM -> MED4; FAM -> NAT; FAM -> WH7;

  // expression edges: up=red  down=blue  n.s.=gray  (N edges thickened)
  edge [arrowhead=normal];
  MED4 -> c1 [color="#d73027", penwidth=4.5];
  MED4 -> c2 [color="#d73027", penwidth=4.5];
  MED4 -> c3 [color="#bdc3c7", penwidth=2.2];
  MED4 -> c4 [color="#4575b4", penwidth=3.0];
  MED4 -> c5 [color="#d73027", penwidth=3.0];
  NAT  -> c6 [color="#4575b4", penwidth=3.0];
  NAT  -> c7 [color="#4575b4", penwidth=3.0];
  WH7  -> c8 [color="#bdc3c7", penwidth=2.2];
}
