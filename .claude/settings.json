{
  "permissions": {
    "allow": [
      "mcp__multiomics-kg__gene_aa_sequence",
      "WebFetch(domain:papers.genomics.lbl.gov)",
      "Bash(env -u VIRTUAL_ENV uv run python analyses/2026-05-30-1136-paperblast_candidate_publications/3_paperblast/scripts/01_inventory.py)",
      "Bash(env -u VIRTUAL_ENV uv run python analyses/2026-05-30-1136-paperblast_candidate_publications/3_paperblast/scripts/02_parse_hits.py)",
      "Bash(env -u VIRTUAL_ENV uv run python analyses/2026-05-30-1136-paperblast_candidate_publications/3_paperblast/scripts/03_dedup_triage.py)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__multiomics-kg__.*",
        "hooks": [
          {
            "type": "command",
            "command": "/home/osnat/github/multiomics_research/hooks/log-mcp-usage.sh",
            "statusMessage": "Logging MCP tool usage"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__multiomics-kg__.*",
        "hooks": [
          {
            "type": "command",
            "command": "/home/osnat/github/multiomics_research/hooks/log-mcp-usage.sh",
            "statusMessage": "Logging MCP tool failure"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {},
  "extraKnownMarketplaces": {}
}
